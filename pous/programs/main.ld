PROGRAM main
  VAR
    Start_PB : BOOL; (* NO Pushbutton — Starts System *)
    Stop_PB : BOOL; (* NC Pushbutton — Normal System Stop *)
    E_Stop : BOOL; (* NC Pushbutton — Safety Stop (De-energizes all outputs) *)
    Book_Infeed_Sensor : BOOL; (* NO Photo-eye — Detects book entering scan zone *)
    Sel_Fiction : BOOL; (* NO Selector/Scanner Input — Category: Fiction *)
    Sel_NonFiction : BOOL; (* NO Selector/Scanner Input — Category: Non-Fiction *)
    Sel_Reference : BOOL; (* NO Selector/Scanner Input — Category: Reference *)
    Pos1_Sensor : BOOL; (* NO Photo-eye — Diverter 1 (Fiction) station *)
    Pos2_Sensor : BOOL; (* NO Photo-eye — Diverter 2 (Non-Fiction) station *)
    Pos3_Sensor : BOOL; (* NO Photo-eye — Diverter 3 (Reference) station *)
    Reset_PB : BOOL; (* NO Pushbutton — Clear Shelf Counters & Jam Alarm *)
    Conveyor_Motor : BOOL; (* Main Conveyor Drive Contactor Coil *)
    Diverter1_Sol : BOOL; (* Fiction Diverter Pneumatic Solenoid Valve *)
    Diverter2_Sol : BOOL; (* Non-Fiction Diverter Pneumatic Solenoid Valve *)
    Diverter3_Sol : BOOL; (* Reference Diverter Pneumatic Solenoid Valve *)
    Run_Lamp : BOOL; (* Green Indicator — System Running *)
    Full_Lamp1 : BOOL; (* Yellow Indicator — Fiction Shelf Full *)
    Full_Lamp2 : BOOL; (* Yellow Indicator — Non-Fiction Shelf Full *)
    Full_Lamp3 : BOOL; (* Yellow Indicator — Reference Shelf Full *)
    Alarm_Horn : BOOL; (* Red Light/Horn — System Fault / Conveyor Jam *)
    Sys_Run : BOOL; (* System Master Latch Bit *)
    Cat_Fiction : BOOL; (* Active Book Latch: Fiction *)
    Cat_NonFiction : BOOL; (* Active Book Latch: Non-Fiction *)
    Cat_Reference : BOOL; (* Active Book Latch: Reference *)
    Sys_Busy : BOOL; (* System Busy Bit (Locks infeed reading until sorting is done) *)
    Jam_Fault : BOOL; (* Latched Conveyor Jam Condition *)
    T1 : TON; (* Pulse Timer — Diverter 1 (PT := T#1.5s) *)
    T2 : TON; (* Pulse Timer — Diverter 2 (PT := T#1.5s) *)
    T3 : TON; (* Pulse Timer — Diverter 3 (PT := T#1.5s) *)
    T_Jam : TON; (* Jam Detection Timer (PT := T#12.0s) *)
    C1 : CTU; (* Counter — Fiction Shelf (PV := 50) *)
    C2 : CTU; (* Counter — Non-Fiction Shelf (PV := 50) *)
    C3 : CTU; (* Counter — Reference Shelf (PV := 50) *)
    TON0 : TON;
    CTU0 : CTU;
    TON1 : TON;
    CTU1 : CTU;
    TON2 : TON;
    CTU2 : CTU;
    TON3 : TON;
  END_VAR

